# ==== Авторизация ====
# Один ключ. Передаётся в заголовке X-API-Key.
SCREC_API_KEY=change-me-please-to-a-long-random-string

# ==== Хранилище ====
# Корень данных. Внутри появится records/ с деревом проектов.
SCREC_DATA_ROOT=/data

# Корень логов.
SCREC_LOG_ROOT=/logs

# ==== Сервер ====
SCREC_HOST=0.0.0.0
SCREC_PORT=8000
SCREC_LOG_LEVEL=INFO
SCREC_ACCESS_LOG=true

# Максимальный размер одного файла-артефакта (МБ).
SCREC_MAX_ARTIFACT_MB=50

# Максимальный размер JSON-payload записи (КБ).
SCREC_MAX_PAYLOAD_KB=512

# Лимит выдачи /sync/changes за один запрос.
SCREC_SYNC_PAGE_SIZE=200

# Включать FTS-индекс (инвертированный, в JSON).
SCREC_FTS_ENABLED=true

# Отдавать OpenAPI-документацию (/docs). Для отладки удобно.
SCREC_OPENAPI_ENABLED=true